# Environment Variables Example for FrontierAtlas Intelligence Engine

# Database Configuration
DATABASE_URL=sqlite:///./data/frontier_atlas.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frontier_atlas

# Redis Configuration (Optional / Distributed Coordination)
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys (Multi-Tier Fallback Chain)
# Tier 1: Gemini Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tier 2: Groq Llama 3
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 3: DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GitHub API Token (Optional, increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Google Sheets Integration (Optional)
# Either path to service account credentials json or json string
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Crawler & Pipeline Settings
MAX_CONCURRENT_REQUESTS=10
DEFAULT_TIMEOUT_SECONDS=15
CRAWL_MAX_RETRIES=3
LOG_LEVEL=INFO
ENVIRONMENT=development
